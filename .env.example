# Port configuration for the backend Express server
PORT=5000

# Sarvam AI API Key (required for Saaras STT)
# Generate one at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini API Key (required for embeddings, query processing, and generation)
# Generate one at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
