{
  "name": "voice-rag-backend",
  "version": "1.0.0",
  "description": "Backend service for voice-enabled RAG",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "benchmark": "ts-node src/benchmark.ts --mock",
    "benchmark:mock": "ts-node src/benchmark.ts --mock",
    "benchmark:live": "ts-node src/benchmark.ts --live",
    "benchmark:voice": "ts-node src/benchmarkVoice.ts",
    "benchmark:harness": "ts-node src/benchmarkHarness.ts",
    "verify-chunking": "ts-node src/chunking_verify.ts",
    "ingest": "ts-node src/ingestion/streaming_ingest.ts",
    "ingest:stream": "ts-node src/ingestion/streaming_ingest.ts",
    "ingest:verify": "ts-node src/verify_dataset_provenance.ts"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "hyparquet": "^1.28.2",
    "hyparquet-compressors": "^1.1.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "snappyjs": "^0.7.0",
    "voice-rag-pipeline": "file:.."
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/node-fetch": "^2.6.11",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
